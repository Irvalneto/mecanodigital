# Copie para .env e preencha. Nunca faça commit do .env.

# --- Claude (https://platform.claude.com -> API Keys) ---
ANTHROPIC_API_KEY=
# Modelo e esforço de raciocínio (low | medium | high). "low" responde mais rápido e barato.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low
# Se o Claude recusar uma mensagem, a API tenta de novo num modelo reserva. "off" desliga
# (desligue se trocar CLAUDE_MODEL para um modelo que não aceite fallbacks).
CLAUDE_FALLBACK=on

# --- WhatsApp Cloud API (developers.facebook.com -> seu app -> WhatsApp -> Configuração da API) ---
# Token de acesso permanente (usuário do sistema no Business Manager).
WHATSAPP_TOKEN=
# "Identificação do número de telefone" (não é o número em si).
WHATSAPP_PHONE_NUMBER_ID=
# Senha qualquer que você inventa e repete na tela de configuração do webhook da Meta.
WHATSAPP_VERIFY_TOKEN=
# Configurações do app -> Básico -> Chave secreta do aplicativo. Garante que só a Meta chama o webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# --- Avisos para a equipe ---
# Seu WhatsApp pessoal, com DDI e DDD (ex. 5511999999999): recebe os leads e pode mandar comandos.
OWNER_WHATSAPP=
# Opcional: URL que recebe cada lead em JSON (n8n, Make, Zapier, Google Apps Script...).
LEAD_WEBHOOK_URL=

# --- Ajustes finos (opcionais) ---
PORT=3000
DATA_DIR=data
# Espera este tempo de silêncio antes de responder, para juntar mensagens picadas.
DEBOUNCE_MS=4000
# Máximo de respostas por contato por hora (proteção contra abuso e custo).
MAX_REPLIES_PER_HOUR=30
# Quantas mensagens recentes o bot relê a cada resposta.
HISTORY_LIMIT=40
TIMEZONE=America/Sao_Paulo
